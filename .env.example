IMPORT_API_KEY=troque-por-uma-chave-forte-antes-de-importar-dados

# Frontend estatico (GitHub Pages). Em producao, use a URL HTTPS do Worker.
VITE_API_BASE_URL=http://localhost:3000
VITE_BASE_PATH=/

# Login público via Supabase (a chave anon é pública; nunca use service_role aqui).
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-publica

# No deploy, configure tambem SUPABASE_URL e SUPABASE_ANON_KEY apenas no
# servidor. A chave anon e publica; nunca configure SUPABASE_SERVICE_ROLE_KEY.
